<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- 1. Cấu hình kết nối MySQL -->
        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="connection.url">jdbc:mysql://localhost:3306/xettuyen2026?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</property>
        <property name="connection.username">root</property>
        <property name="connection.password">1234</property> <!-- Thay bằng mật khẩu của bạn -->

        <!-- 2. Cấu hình Hibernate Dialect (Dành cho MySQL 8+) -->
        <property name="dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- 3. Cấu hình hiển thị SQL ra Console để debug -->
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>
        <property name="highlight_sql">true</property>

        <!-- 4. Quản lý database schema (update: tự động cập nhật bảng nếu có thay đổi) -->
        <property name="hbm2ddl.auto">update</property>

        <!-- 5. Khai báo các Entity (Mapping) -->
        <mapping class="com.tuyensinh.model.User"/>
        <mapping class="com.tuyensinh.model.Role"/>
        <mapping class="com.tuyensinh.model.RolePermission"/>
        <mapping class="com.tuyensinh.model.ThiSinh"/>
        <mapping class="com.tuyensinh.model.NganhToHop"/>
        <mapping class="com.tuyensinh.model.BangQuyDoi"/>
        <mapping class="com.tuyensinh.model.Nganh"/>
        <mapping class="com.tuyensinh.model.TohopMonthi"/>
        <mapping class="com.tuyensinh.model.DiemThi"/>
        <mapping class="com.tuyensinh.model.DiemCong"/>
        <mapping class="com.tuyensinh.model.NguyenVong"/>

    </session-factory>
</hibernate-configuration>